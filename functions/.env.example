# Copie este arquivo para .env (nunca versionado) e preencha com o access
# token de PRODUÇÃO de uma conta do Mercado Pago — precisa ser uma conta
# própria do SOS Estrada, separada da usada pelo Match.
# Painel do Mercado Pago > Suas integrações > Credenciais de produção.
MERCADOPAGO_ACCESS_TOKEN=
# E-mail que envia os avisos de fim de plano aos prestadores (Gmail com
# senha de app de 16 caracteres, igual ao Caronas — não a senha normal).
SOS_EMAIL_USER=
SOS_EMAIL_PASSWORD=
# Google Play Billing (confirmarCompraGooglePlayPrestador e transação externa
# do Mercado Pago escolhido na tela do Google): pacote do app e a chave JSON
# inteira da conta de serviço, numa linha só (a mesma do Caronas, com acesso
# ao app SOS Estrada no Play Console).
GOOGLE_PLAY_PACKAGE_NAME=com.cjstudio.sosestrada
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
