<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:name=".SosEstradaApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MaterialComponents.Light.NoActionBar"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">
        <activity
            android:name=".CadastroAdminActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".AtendimentoActivity"
            android:exported="false" />
        <activity
            android:name=".SocorroActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="false" />
        <activity
            android:name=".AdminActivity"
            android:exported="false" />
        <activity
            android:name=".LoginMotoristaActivity"
            android:exported="false" />
        <activity
            android:name=".LoginPrestadorActivity"
            android:exported="false" />
        <activity
            android:name=".MotoristaDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".PrestadorDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".AssinaturaActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <!-- Retorno do checkout do Mercado Pago (back_urls em
                 criarPreferenciaPagamentoPrestador, functions/index.js). A
                 confirmação de verdade vem do webhook via Firestore — esse
                 deep link só traz o usuário de volta pro app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sosestrada" android:host="payment_success" />
                <data android:scheme="sosestrada" android:host="payment_failure" />
                <data android:scheme="sosestrada" android:host="payment_pending" />
            </intent-filter>
        </activity>
        <activity
            android:name=".CadastroMotoristaActivity"
            android:exported="false" />
        <activity
            android:name=".CadastroPrestadorActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>