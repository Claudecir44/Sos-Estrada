<?xml version="1.0" encoding="utf-8"?>
<!-- Uma conversa do Chat Admin (ChatAdminConversaAdapter): foto e nome do
     outro admin/colaborador, prévia, hora e as não lidas. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/AdminCard"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivFotoChatAdmin"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@color/admin_chip"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_admin"
            app:shapeAppearanceOverlay="@style/AdminLogoCircular" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNomeChatAdmin"
                style="@style/AdminTitulo"
                android:layout_width="match_parent"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tvPreviaChatAdmin"
                style="@style/AdminLinha"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHoraChatAdmin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/admin_texto_secundario"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvNaoLidasChatAdmin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_badge_notificacao"
                android:gravity="center"
                android:minWidth="22dp"
                android:paddingHorizontal="6dp"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
