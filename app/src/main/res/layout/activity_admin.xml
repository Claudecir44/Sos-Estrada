<?xml version="1.0" encoding="utf-8"?>
<!-- Painel administrativo: cabeçalho (saudação + totais) e, abaixo, a lista
     escolhida no seletor — motoristas, prestadores, solicitações ou
     conversas, tudo na mesma tela. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/admin_fundo"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Cabeçalho -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_admin_header"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="20dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.1"
                    android:text="🛡️ SOS ESTRADA"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Painel Administrativo"
                    android:textColor="@android:color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSaudacaoAdmin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Olá!"
                    android:textColor="#E6FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSairAdmin"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sair"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                app:cornerRadius="20dp"
                app:strokeColor="#99FFFFFF" />
        </LinearLayout>

        <!-- Totais: quadrados fixos, só informativos -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp">

            <LinearLayout
                android:id="@+id/quadroMotoristas"
                style="@style/AdminQuadroTotal"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toStartOf="@id/quadroPrestadores"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚗"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/tvTotalMotoristas"
                    style="@style/AdminNumeroTotal" />

                <TextView
                    style="@style/AdminRotuloTotal"
                    android:text="Motoristas" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/quadroPrestadores"
                style="@style/AdminQuadroTotal"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toStartOf="@id/quadroPedidos"
                app:layout_constraintStart_toEndOf="@id/quadroMotoristas"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔧"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/tvTotalPrestadores"
                    style="@style/AdminNumeroTotal" />

                <TextView
                    style="@style/AdminRotuloTotal"
                    android:text="Prestadores" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/quadroPedidos"
                style="@style/AdminQuadroTotal"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/quadroPrestadores"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🆘"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/tvTotalSolicitacoes"
                    style="@style/AdminNumeroTotal" />

                <TextView
                    style="@style/AdminRotuloTotal"
                    android:text="Pedidos" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

    <!-- Seletor: o que aparece abaixo -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/grupoListas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:checkedChip="@id/chipMotoristas"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMotoristas"
                style="@style/AdminChipSeletor"
                android:text="🚗 Motoristas" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPrestadores"
                style="@style/AdminChipSeletor"
                android:text="🔧 Prestadores" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSolicitacoes"
                style="@style/AdminChipSeletor"
                android:text="📋 Solicitações" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMensagens"
                style="@style/AdminChipSeletor"
                android:text="💬 Mensagens" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Conteúdo -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvListaVazia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:textColor="@color/admin_texto_secundario"
            android:textSize="15sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvLista"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="16dp" />
    </FrameLayout>

</LinearLayout>
