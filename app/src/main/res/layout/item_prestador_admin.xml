<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/AdminCard"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivLogoPrestador"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@color/admin_chip"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_placeholder_logo"
            app:shapeAppearanceOverlay="@style/AdminLogoCircular" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNomePrestador"
                style="@style/AdminTitulo"
                android:layout_width="match_parent"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Nome" />

            <TextView
                android:id="@+id/tvBloqueadoPrestador"
                style="@style/AdminChip"
                android:layout_marginTop="4dp"
                android:backgroundTint="@color/admin_vermelho_claro"
                android:textColor="#B91C1C"
                android:text="🚫 Bloqueado"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvServicoPrestador"
                style="@style/AdminChip"
                android:layout_marginTop="6dp"
                android:backgroundTint="@color/admin_laranja_claro"
                android:textColor="@color/admin_laranja"
                android:text="🔧 Serviço" />

            <TextView
                android:id="@+id/tvTelefonePrestador"
                style="@style/AdminLinha"
                android:layout_marginTop="8dp"
                android:text="📞 Telefone" />

            <TextView
                android:id="@+id/tvEmailPrestador"
                style="@style/AdminLinha"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="✉️ E-mail" />

            <TextView
                android:id="@+id/tvEnderecoPrestador"
                style="@style/AdminLinha"
                android:text="📍 Endereço" />

            <TextView
                android:id="@+id/tvCnpjPrestador"
                style="@style/AdminLinha"
                android:text="CNPJ • Preço" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
