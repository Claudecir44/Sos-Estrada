<?xml version="1.0" encoding="utf-8"?>
<!-- Um pagamento de assinatura no Financeiro do app admin. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/AdminCard"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvNomePagamento"
                style="@style/AdminTitulo"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvValorPagamento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/admin_verde"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvEmailPagamento"
            style="@style/AdminLinha" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDatasPagamento"
                style="@style/AdminLinha"
                android:layout_width="0dp"
                android:layout_marginTop="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvStatusPagamento"
                style="@style/AdminChip" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
