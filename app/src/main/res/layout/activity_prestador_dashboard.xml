<?xml version="1.0" encoding="utf-8"?>
<!-- Tela principal do prestador: cabeçalho verde (mesmo formato do painel
     admin), atender solicitações em destaque, assinatura e cadastro. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/prestador_fundo"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context=".PrestadorDashboardActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Cabeçalho (mesmo formato do painel admin, em verde) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_prestador_header"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="56dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:orientation="horizontal">

                <!-- Configurações no canto superior esquerdo, ao lado da foto
                     (termos, regras, assinatura), com a situação do cadastro
                     e os dias do plano embaixo (StatusAssinatura.resumo). -->
                <LinearLayout
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="2dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                <ImageView
                    android:id="@+id/btnConfiguracoesPrestador"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_admin_avatar"
                    android:backgroundTint="@color/grafite"
                    android:elevation="3dp"
                    android:clickable="true"
                    android:contentDescription="Configurações"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:padding="7dp"
                    android:src="@drawable/ic_configuracoes" />

                <TextView
                    android:id="@+id/tvCadastroStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_status_cadastro"
                    android:gravity="center"
                    android:maxLines="2"
                    android:paddingStart="4dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="1dp"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:visibility="invisible"
                    tools:text="Cadastro ativo"
                    tools:textColor="@color/verde_neon"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tvPlanoStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:maxLines="2"
                    android:textColor="@android:color/black"
                    android:textSize="8sp"
                    tools:text="Plano free 45/60 dias" />
                </LinearLayout>

                <!-- Foto no canto, com o primeiro nome embaixo -->
                <LinearLayout
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivFotoPrestadorPainel"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="#33FFFFFF"
                        android:padding="2dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_admin"
                        app:shapeAppearanceOverlay="@style/AdminLogoCircular"
                        app:strokeColor="#CCFFFFFF"
                        app:strokeWidth="2dp" />

                    <TextView
                        android:id="@+id/tvNomePrestadorPainel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="Prestador"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.1"
                        android:maxLines="1"
                        android:text="🛡️ SOS ESTRADA"
                        android:textColor="#CCFFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:maxLines="2"
                        android:text="Painel do Prestador"
                        android:textColor="@android:color/white"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>


                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMeuPerfilPrestador"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:backgroundTint="@android:color/white"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="Meu Perfil"
                        android:textAllCaps="false"
                        android:textColor="@color/prestador_verde_escuro"
                        android:textSize="11sp"
                        app:cornerRadius="15dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVoltar"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:layout_marginTop="6dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="Sair"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="11sp"
                        app:cornerRadius="15dp"
                        app:strokeColor="#99FFFFFF" />
                </LinearLayout>
            </LinearLayout>

            <!-- Serviço oferecido -->
            <TextView
                android:id="@+id/tvServicoPainel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_admin_chip"
                android:backgroundTint="#26FFFFFF"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="🔧 Carregando serviço…"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Atender: a ação principal, sobre a base do cabeçalho -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnAtender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="-40dp"
            android:layout_marginEnd="16dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_prestador_atender"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp">

                <!-- Ícone + bolinha de alertas (solicitações novas e
                     mensagens não lidas), ver PrestadorDashboardActivity. -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_admin_avatar"
                        android:backgroundTint="#33FFFFFF"
                        android:gravity="center"
                        android:text="🛠️"
                        android:textSize="30sp" />

                    <TextView
                        android:id="@+id/badgeAtender"
                        style="@style/BadgeNotificacao" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Atender solicitações"
                        android:textColor="@android:color/white"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Pedidos de socorro recebidos"
                        android:textColor="#F2FFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvSetaAtender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@android:color/white"
                    android:textSize="34sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Solicitações recebidas (AtendimentoFragment): abrem aqui mesmo, ao tocar no cartão acima -->
        <FrameLayout
            android:id="@+id/containerListaAtendimento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
