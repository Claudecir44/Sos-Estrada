<?xml version="1.0" encoding="utf-8"?>
<!-- Chat Admin (ChatAdminActivity): conversa entre admins/colaboradores,
     no cinza do painel admin. Bolhas = as mesmas do chat dos usuários. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/admin_fundo"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/admin_cinza_escuro"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="10dp">

        <TextView
            android:id="@+id/btnVoltarChatAdmin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Voltar"
            android:padding="8dp"
            android:text="⬅"
            android:textColor="@android:color/white"
            android:textSize="22sp" />

        <ImageView
            android:id="@+id/ivFotoOutroChatAdmin"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:contentDescription="Foto"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_admin" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNomeOutroChatAdmin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@android:color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💬 Chat Admin · mensagens cifradas"
                android:textColor="#CCFFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvVazioChatAdmin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:text="Nenhuma mensagem ainda. Envie a primeira!"
        android:textColor="@color/admin_texto_secundario"
        android:textSize="15sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMensagensChatAdmin"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingVertical="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F5F5F5"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <EditText
            android:id="@+id/edtMensagemChatAdmin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@android:drawable/editbox_background"
            android:hint="Digite uma mensagem..."
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:padding="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEnviarChatAdmin"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:backgroundTint="@color/admin_cinza_escuro"
            android:contentDescription="Enviar"
            android:text="➤"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            app:cornerRadius="24dp" />
    </LinearLayout>

</LinearLayout>
