<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/AdminCard"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivFotoMotorista"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@color/admin_chip"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_admin"
            app:shapeAppearanceOverlay="@style/AdminLogoCircular" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNomeMotorista"
                style="@style/AdminTitulo"
                android:layout_width="match_parent"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Nome" />

            <TextView
                android:id="@+id/tvBloqueadoMotorista"
                style="@style/AdminChip"
                android:layout_marginTop="4dp"
                android:backgroundTint="@color/admin_vermelho_claro"
                android:textColor="#B91C1C"
                android:text="🚫 Bloqueado"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvEmailMotorista"
                style="@style/AdminLinha"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="e-mail" />

            <TextView
                android:id="@+id/tvVeiculoMotorista"
                style="@style/AdminChip"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/admin_azul_claro"
                android:textColor="@color/admin_azul"
                android:text="🚗 Veículo" />

            <TextView
                android:id="@+id/tvTelefoneMotorista"
                style="@style/AdminLinha"
                android:layout_marginTop="8dp"
                android:text="📞 Telefone" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
