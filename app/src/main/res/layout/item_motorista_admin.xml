<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/AdminCard"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvAvatarMotorista"
            style="@style/AdminAvatar"
            android:backgroundTint="@color/admin_azul"
            android:text="M" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNomeMotorista"
                style="@style/AdminTitulo"
                android:layout_width="match_parent"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Nome" />

            <TextView
                android:id="@+id/tvEmailMotorista"
                style="@style/AdminLinha"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="e-mail" />

            <TextView
                android:id="@+id/tvVeiculoMotorista"
                style="@style/AdminChip"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/admin_azul_claro"
                android:textColor="@color/admin_azul"
                android:text="🚗 Veículo" />

            <TextView
                android:id="@+id/tvTelefoneMotorista"
                style="@style/AdminLinha"
                android:layout_marginTop="8dp"
                android:text="📞 Telefone" />

            <TextView
                android:id="@+id/tvUidMotorista"
                style="@style/AdminLinha"
                android:textSize="11sp"
                android:textColor="#9CA3AF"
                android:text="ID" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
