<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Cabeçalho com logo e nome -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <ImageView
                android:id="@+id/ivLogoPrestador"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_placeholder_logo"
                android:scaleType="centerCrop"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNomePrestador"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nome do prestador"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#333333" />

                <TextView
                    android:id="@+id/tvServicoPrestador"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Serviço: ..."
                    android:textSize="14sp"
                    android:textColor="#555555" />

            </LinearLayout>
        </LinearLayout>

        <!-- Distância -->
        <TextView
            android:id="@+id/tvDistanciaPrestador"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📏 Distância: calculando..."
            android:textSize="14sp"
            android:textColor="#2196F3"
            android:layout_marginBottom="4dp" />

        <!-- Localização -->
        <TextView
            android:id="@+id/tvLocalizacaoPrestador"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📍 Localização: ..."
            android:textSize="14sp"
            android:textColor="#555555"
            android:layout_marginBottom="4dp" />

        <!-- Telefone -->
        <TextView
            android:id="@+id/tvTelefonePrestador"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📞 Telefone: ..."
            android:textSize="14sp"
            android:textColor="#555555"
            android:layout_marginBottom="12dp" />

        <!-- NOVO: Status da solicitação -->
        <TextView
            android:id="@+id/tvStatusSolicitacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="8dp"
            android:background="@drawable/bg_status_solicitacao"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <!-- Botões de ação, em grade 2x2 do mesmo tamanho (BotaoCardSocorro).
             A 2ª linha só existe com uma solicitação feita a este prestador. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-3dp"
            android:layout_marginEnd="-3dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnChamar"
                style="@style/BotaoCardSocorro"
                android:text="📞 Chamar"
                android:backgroundTint="#4CAF50" />

            <Button
                android:id="@+id/btnLocalizar"
                style="@style/BotaoCardSocorro"
                android:text="📍 Localização do Prestador"
                android:backgroundTint="#2196F3" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutBotoesSolicitacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-3dp"
            android:layout_marginEnd="-3dp"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:visibility="gone">

            <!-- Ativo só com a solicitação aceita (cinza enquanto pendente).
                 marginTop = espaço da bolinha do Mensagem ao lado. -->
            <Button
                android:id="@+id/btnEnviarLocalizacao"
                style="@style/BotaoCardSocorro"
                android:layout_marginTop="6dp"
                android:text="📡 Enviar Minha Localização"
                android:backgroundTint="#00897B" />

            <!-- Mensagem + bolinha com as não lidas (naoLidasMotorista) -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clipChildren="false">

                <Button
                    android:id="@+id/btnMensagem"
                    style="@style/BotaoCardSocorro"
                    android:layout_width="match_parent"
                    android:layout_marginTop="6dp"
                    android:text="💬 Mensagem"
                    android:backgroundTint="#9C27B0" />

                <TextView
                    android:id="@+id/badgeMensagem"
                    style="@style/BadgeNotificacao" />
            </FrameLayout>

        </LinearLayout>

        <!-- Botão Solicitar serviço -->
        <Button
            android:id="@+id/btnSolicitar"
            style="@style/BotaoCardSocorro"
            android:layout_width="match_parent"
            android:layout_weight="0"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            android:layout_marginTop="6dp"
            android:text="🚨 Solicitar serviço"
            android:backgroundTint="#FF9800"
            android:textSize="14sp"
            android:maxLines="1" />

    </LinearLayout>
</androidx.cardview.widget.CardView>