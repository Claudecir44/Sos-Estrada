<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvMensagemConfirmacao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ao aceitar você concorda que estará indo socorrer o motorista, e será enviada uma mensagem ao mesmo, confirmando seu deslocamento."
        android:textSize="14sp"
        android:textColor="#333"
        android:layout_marginBottom="16dp" />

    <CheckBox
        android:id="@+id/checkBoxConfirmacao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Li e concordo com os termos acima" />

</LinearLayout>