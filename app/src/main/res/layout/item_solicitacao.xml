<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvMotoristaNome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Motorista: ..."
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333" />

        <TextView
            android:id="@+id/tvMotoristaVeiculo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🚗 Veículo: ..."
            android:textSize="14sp"
            android:textColor="#555"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvMotoristaPlaca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔢 Placa: ..."
            android:textSize="14sp"
            android:textColor="#555" />

        <TextView
            android:id="@+id/tvMotoristaTelefone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📞 Telefone: ..."
            android:textSize="14sp"
            android:textColor="#555" />

        <TextView
            android:id="@+id/tvMotoristaEndereco"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📍 Endereço: ..."
            android:textSize="14sp"
            android:textColor="#555"
            android:layout_marginBottom="12dp" />

        <!-- NOVO: Mensagem de cancelamento (só aparece se status for "cancelado") -->
        <TextView
            android:id="@+id/tvCancelamento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⛔ Motorista cancelou o serviço"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#D32F2F"
            android:gravity="center"
            android:padding="8dp"
            android:background="#FFEBEE"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/layoutBotoes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAceitar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="✅ Aceitar"
                android:backgroundTint="#4CAF50"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:layout_marginEnd="8dp"
                app:cornerRadius="8dp" />

            <Button
                android:id="@+id/btnRecusar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="❌ Recusar"
                android:backgroundTint="#D32F2F"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                app:cornerRadius="8dp" />

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>