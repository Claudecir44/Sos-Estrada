<?xml version="1.0" encoding="utf-8"?>
<!-- Cabeçalho da área do prestador: degradê verde clarinho com a base arredondada. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="@color/prestador_verde_inicio"
        android:endColor="@color/prestador_verde" />
    <corners
        android:bottomLeftRadius="32dp"
        android:bottomRightRadius="32dp" />
</shape>
